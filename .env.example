# --- SMTP (глобальный отправитель на всё приложение) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
# Пароль приложения (Gmail: App Password, Яндекс: пароль приложения), не основной пароль
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- База данных (SQLite) ---
DATABASE_URL=sqlite:///./vibe_mail.db

# --- CORS (разрешённые origin фронта в dev; через запятую) ---
CORS_ORIGINS=http://localhost:5173
