# --- SMTP (глобальный отправитель на всё приложение) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
# Пароль приложения (Gmail: App Password, Яндекс: пароль приложения), не основной пароль
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- База данных (SQLite) ---
DATABASE_URL=sqlite:///./vibe_mail.db

# --- Источник конфигов: ssh (VPN-сервер) или fake (заглушка для разработки) ---
CONFIG_SOURCE=ssh

# --- SSH к VPN-серверу ---
SSH_HOST=vpn.example.com
SSH_PORT=22
SSH_USER=user
SSH_PASSWORD=
SSH_TIMEOUT=30

# --- API панели AmneziaWG (слушает localhost на VPN-сервере) ---
VPN_API_URL=http://127.0.0.1:8080
VPN_API_USER=vpnuser
VPN_API_PASSWORD=
# Пусто — берём единственный сервер панели
VPN_SERVER_ID=

# --- CORS (разрешённые origin фронта в dev; через запятую) ---
CORS_ORIGINS=http://localhost:5173
